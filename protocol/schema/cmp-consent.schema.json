{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scruter.net/schemas/mobile/v1/cmp-consent.schema.json",
  "title": "POST /cmp/consent from an app (one per decision)",
  "description": "docs/CMP-MOBILE.md §3.3, §4.2; docs/API.md §5.1. Strict: what a conforming SDK sends. g ∪ n = the version's optional purposes, g ∩ n = ∅ (checked by the server, not expressible here).",
  "type": "object",
  "required": ["s", "i", "b", "c", "o", "l", "h", "g", "n", "r", "w", "cv", "p", "ap", "av"],
  "additionalProperties": false,
  "properties": {
    "s": {"type": "string", "pattern": "^[A-Z0-9]{4,16}$"},
    "i": {"type": "string", "pattern": "^cns_[0-9a-f]{20}$"},
    "b": {"type": "integer", "minimum": 1},
    "t": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "a": {"enum": ["a", "b"]},
    "c": {"enum": ["accept_all", "reject_all", "custom", "close", "withdraw"]},
    "o": {"enum": ["banner", "preferences", "api"]},
    "l": {"type": "string", "minLength": 2, "maxLength": 8},
    "h": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "g": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$"}},
    "n": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$"}},
    "m": {"type": "array", "maxItems": 7, "items": {"enum": ["ad_storage", "ad_user_data", "ad_personalization", "analytics_storage", "functionality_storage", "personalization_storage", "security_storage"]}},
    "tc": {
      "description": "The TC string; for a site with Google's other ad tech providers, followed by ~ and Google's Additional Consent string v2",
      "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[A-Za-z0-9_.-]+(~2~[0-9.]*~dv\\.[0-9.]*)?$"
    },
    "gv": {"type": "integer", "minimum": 1},
    "r": {"type": "integer", "minimum": 1},
    "w": {"type": "integer", "minimum": 0, "maximum": 10000},
    "ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "cv": {"type": "string", "pattern": "^(ios|android|react_native|flutter)/[0-9A-Za-z.+-]{1,30}$"},
    "p": {"enum": ["ios", "android"]},
    "ap": {"type": "string", "maxLength": 155, "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z0-9_-]+)+$"},
    "av": {"type": "string", "minLength": 1, "maxLength": 40},
    "dbg": {"enum": [0, 1]}
  },
  "dependentRequired": {"t": ["a"], "a": ["t"], "tc": ["gv"]}
}
