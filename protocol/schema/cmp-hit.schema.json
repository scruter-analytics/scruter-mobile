{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scruter.net/schemas/mobile/v1/cmp-hit.schema.json",
  "title": "POST /cmp/hit from an app (one per opening)",
  "description": "docs/CMP-MOBILE.md §3.10, §4.2; docs/API.md §5.1. Strict: what a conforming SDK sends (the server ignores unknown keys).",
  "type": "object",
  "required": ["s", "b", "l", "d", "w", "cv", "p", "ap", "av"],
  "additionalProperties": false,
  "properties": {
    "s": {"type": "string", "pattern": "^[A-Z0-9]{4,16}$"},
    "b": {"type": "integer", "minimum": 1},
    "t": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "a": {"enum": ["a", "b"]},
    "l": {"type": "string", "minLength": 2, "maxLength": 8},
    "d": {"enum": [0, 1]},
    "w": {"type": "integer", "minimum": 0, "maximum": 10000},
    "cv": {"type": "string", "pattern": "^(ios|android|react_native|flutter)/[0-9A-Za-z.+-]{1,30}$"},
    "e": {"enum": [0, 1]},
    "p": {"enum": ["ios", "android"]},
    "ap": {"type": "string", "maxLength": 155, "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z0-9_-]+)+$"},
    "av": {"type": "string", "minLength": 1, "maxLength": 40},
    "dbg": {"enum": [0, 1]}
  },
  "dependentRequired": {"t": ["a"], "a": ["t"]}
}
