{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scruter.net/schemas/mobile/v1/team-register.schema.json",
  "title": "POST /m/v1/team/register",
  "description": "docs/API.md §5.3, docs/MOBILE.md §3.12. Exactly one of token (QR code) and debug_key (debug build).",
  "type": "object",
  "required": ["app", "platform", "model", "os", "form", "app_version", "build_kind"],
  "oneOf": [{"required": ["token"]}, {"required": ["debug_key"]}],
  "properties": {
    "app": {"type": "string", "pattern": "^[A-Z0-9_-]{1,32}$"},
    "token": {"type": "string", "pattern": "^scr_qr_[A-Za-z0-9_-]{32}$"},
    "debug_key": {"type": "string", "pattern": "^scr_dbg_[A-Za-z0-9_-]{43}$"},
    "platform": {"enum": ["ios", "android"]},
    "model": {"type": "string", "minLength": 1, "maxLength": 60},
    "os": {"type": "string", "minLength": 1, "maxLength": 20},
    "form": {"enum": ["phone", "tablet"]},
    "app_version": {"type": "string", "minLength": 1, "maxLength": 40},
    "build_kind": {"enum": ["release", "testflight", "test", "debug"]}
  }
}
