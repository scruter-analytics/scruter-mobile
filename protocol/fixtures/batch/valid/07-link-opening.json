        "path": "/m/v1/batch",
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "v": 1,
          "a": "{{APP}}",
          "b": "{{BATCH}}",
          "t": "{{NOW}}",
          "sdk": "ios/1.0.0",
          "ce": "",
          "dbg": 0,
          "s": [
            {
              "id": "{{SESSION}}",
              "d": "{{DAILY}}",
              "q": 1,
