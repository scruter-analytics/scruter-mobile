{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2021"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "lib",
    "types": ["jest", "node"]
  },
  "include": ["src", "__tests__", "__mocks__"]
}
